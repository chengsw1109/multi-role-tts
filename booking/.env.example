# 預約系統設定（複製成專案根目錄的 .env）

BOOKING_PORT=3100
BOOKING_TITLE=線上預約
BOOKING_TIMEZONE=Asia/Taipei
BOOKING_SLOT_MINUTES=30
# 每個時段前後保留的緩衝分鐘數
BOOKING_BUFFER_MINUTES=0
# 最少要提前多久才能預約
BOOKING_LEAD_MINUTES=120
# 最多可預約幾天內的時段
BOOKING_MAX_DAYS_AHEAD=30
# 週幾:時段（0=週日、6=週六），多組用分號隔開
BOOKING_HOURS=1-5:09:00-12:00,13:30-18:00; 6:10:00-14:00

# 要寫入的日曆；使用者本人的主日曆填 primary
GOOGLE_CALENDAR_ID=primary

# 方式一：OAuth（建議，個人 Gmail 帳號可用，且能自動寄邀請給預約者）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# 方式二：服務帳戶（把日曆分享給這個帳戶並給「變更活動」權限；無法自動邀請與會者）
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
